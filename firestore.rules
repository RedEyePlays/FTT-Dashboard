rules_version = '2';

// IMPORTANT: These rules encode the app's role model. Test them in the Firebase
// console Rules Playground before relying on them in production — they cannot be
// exercised in CI.
//
// Data model:
//   users/{uid}                      -> { email, role, workspaceId, disabled, ... }
//   workspaceInvites/{email}         -> { email, workspaceId, role }
//   user_data/{workspaceId}/...      -> all shared shop collections
// workspaceId == the owning account's uid; staff share the owner's workspace.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(myUserPath()); }
    function me() { return get(myUserPath()).data; }
    function myWorkspace() { return me().workspaceId; }
    function myRole() { return me().role; }
    // `disabled` is optional on the user doc; use get(...,false) so a missing
    // field is treated as "not disabled" instead of erroring (an errored rule
    // denies, which previously blocked every workspace read for normal users).
    // Any active account in the workspace, INCLUDING the kiosk device.
    function activeAnyMemberOf(ws) { return hasProfile() && me().get('disabled', false) != true && myWorkspace() == ws; }
    // An active HUMAN member. The kiosk device is excluded here rather than at
    // each call site, which is what makes every collection in this file
    // deny-by-default for it: `allow read: if activeMemberOf(ws)` appears on
    // sales, inventory, customers, repairs, settlements, drop-offs, pay
    // periods and more, and a device by the front door must read none of them.
    // The two places a kiosk legitimately needs access (kioskStaff and
    // timeEntries) name it explicitly instead.
    function activeMemberOf(ws) { return activeAnyMemberOf(ws) && myRole() != 'kiosk'; }
    function isOwnerOf(ws) { return activeMemberOf(ws) && myRole() == 'owner'; }
    function isTechOf(ws) { return activeMemberOf(ws) && myRole() == 'technician'; }
    // The shared door-iPad DEVICE account. It is NOT a person: it holds no
    // permissions in services/rbac.ts, never appears in payroll, and below it
    // is denied read on every collection except the kiosk punch roster and
    // timeEntries. Everything it may do is spelled out explicitly; nothing
    // grants it anything by default.
    function isKioskOf(ws) { return activeAnyMemberOf(ws) && myRole() == 'kiosk'; }

    // A non-technician, non-kiosk active member (owner/manager/employee) — the
    // roles that may write general shop data.
    //
    // THE KIOSK EXCLUSION IS LOAD-BEARING: this was `myRole() != 'technician'`,
    // which a kiosk account would have satisfied — handing the door iPad write
    // access to inventory, sales, customers, repairs and drop-offs. Excluded
    // by name so a new role can never inherit shop-write access simply by not
    // being a technician.
    function isStaffOf(ws) { return activeMemberOf(ws) && myRole() != 'technician'; }
    // Owner or manager — the payroll.manage / users.* / audit.view tier.
    //
    // HISTORY: this used to also gate cash.reconcile, sales.void, sales.return
    // and dropoffs.manage. Employees have since been granted all four (see
    // services/rbac.ts's employee role) — they run the shop end-to-end and
    // oversight comes from attribution + auditLogs, not from blocking the
    // write. Those collections are gated by isStaffOf() now; this helper
    // remains for the things that are genuinely still manager+:
    // payPeriodApprovals, any-user timeEntry corrections, and the expense
    // ledger (which employees lost entirely — see the expenses block).
    function isManagerUp(ws) { return activeMemberOf(ws) && (myRole() == 'owner' || myRole() == 'manager'); }
    // Employee or technician — active staff who are NOT manager/owner tier.
    // Both are trusted with ONLY their own timeEntries (see the match block
    // below) — an employee is not more trusted than a technician here, unlike
    // the old isStaffOf() split which let any employee write ANY coworker's
    // hours with no ownership check at all.
    // Kiosk excluded for the same reason: it has no shifts of its own, so it
    // must never write a timeEntry for `request.auth.uid` (which is the
    // device). It punches for OTHER people through the kiosk branch below,
    // which has its own, tighter conditions.
    function isSelfServiceStaffOf(ws) { return activeMemberOf(ws) && !isManagerUp(ws); }

    // A kiosk punch may only ever touch TODAY's shift. Nobody fixes their
    // hours at the iPad: a yesterday entry is a correction, and corrections
    // are the owner/manager's job on a real screen with an audit trail.
    function withinLastDay(ms) { return ms > request.time.toMillis() - 86400000 && ms <= request.time.toMillis() + 600000; }
    // The only fields a kiosk-written entry may contain at all.
    function kioskEntryKeys() { return ['id', 'userId', 'userEmail', 'clockIn', 'clockOut', 'breaks', 'createdAt', 'source']; }
    // The only fields a kiosk UPDATE may CHANGE — clock out, or start/end a
    // break. Never clockIn, never userId, never hours by any other route.
    function kioskUpdateKeys() { return ['clockOut', 'breaks']; }
    // How far back a kiosk may LIST timeEntries: FOUR DAYS (100h here, a touch
    // wider than the client's 96h so a clock-skewed device doesn't sit exactly
    // on the boundary and get its whole query denied).
    //
    // Wider than withinLastDay because the punch screen has to SEE a shift it
    // will then refuse to touch. Two days was not enough: somebody who forgot
    // to clock out on Friday and came back Monday had their open shift fall
    // outside the window entirely, so the screen offered "Clock in" and they
    // ended up with two open entries. Four days covers a weekend and a long
    // weekend. Kept in step with services/firestoreDb.ts's
    // KIOSK_TIME_ENTRY_WINDOW_MS.
    //
    // Note this only widens what a kiosk may READ. What it may WRITE is still
    // withinLastDay — a stale shift is a correction, and the door iPad must
    // never decide what somebody's hours were.
    function withinKioskReadWindow(ms) { return ms > request.time.toMillis() - 360000000; }
    // The page cap a kiosk list must carry. Belt and braces with the clockIn
    // floor below: the floor is what actually bounds the data, this stops an
    // unbounded scan being attempted at all.
    function kioskListLimit() { return 500; }
    // A kiosk write to `breaks` may only GROW the list — append a new break,
    // or end the last open one. It may never SHRINK it.
    //
    // THE HOLE THIS CLOSES: the kiosk update branch checked WHICH fields
    // change, never HOW `breaks` changes. Anyone holding the kiosk credential
    // could shorten or drop a break on today's entry, which inflates paid
    // hours for any unpaid break reason. The door UI never does that — the
    // permission was simply wider than the intent.
    //
    // Rules cannot deep-compare array contents, so this is the coarse half;
    // the real integrity check (same ids, same order, at most one change) is
    // domain/kiosk.ts's validateBreakEvolution, which App.tsx runs before it
    // writes and audits on mismatch.
    function kioskBreaksOnlyGrow() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['breaks'])
        || request.resource.data.breaks.size() >= resource.data.breaks.size();
    }

    // The exact field set the real clock-in/clock-out/break UI writes
    // (App.tsx's handleClockIn/handleClockOut/handleStartBreak/handleEndBreak)
    // — self-service creates/updates may touch ONLY these, so an employee or
    // technician writing directly (bypassing the UI) can't sneak in
    // `corrections`/audit fields that only the manager-correction flow may set.
    function timeEntrySelfKeys() { return ['id', 'userId', 'userEmail', 'clockIn', 'clockOut', 'breaks', 'createdAt']; }
    // Fields a self-service UPDATE may actually CHANGE (not just carry over
    // unchanged from a prior manager correction) — clockIn and userId can
    // never change after creation via this path.
    function timeEntrySelfUpdateKeys() { return ['clockOut', 'breaks', 'userEmail']; }
    // +/- 10 minutes of clock skew/network latency allowance — generous
    // enough for a real device, tight enough that a self-service write can't
    // backdate a shift or extend a clock-out to inflate pay.
    function closeToNow(ms) { return ms > request.time.toMillis() - 600000 && ms < request.time.toMillis() + 600000; }

    // Role rank for PIN assignment (domain/pin.ts mirrors this exactly): an
    // owner/manager may set a PIN only for someone STRICTLY below their own
    // rank — never a peer or above, so a manager can never PIN another manager
    // or the owner, and nobody can PIN themselves via this path.
    // 'kiosk' ranks BELOW everyone (-1) and is refused outright by the PIN
    // branch as well — mirrors domain/pin.ts's canAssignPin. Without the
    // explicit -1 it would have fallen into the `: 0` technician slot and been
    // a valid app-unlock-PIN target, which a shared device must never be.
    function roleRank(r) {
      return r == 'owner' ? 3 : r == 'manager' ? 2 : r == 'employee' ? 1 : r == 'technician' ? 0 : -1;
    }
    // The kiosk PUNCH pin (a different credential from pinKeys() below — see
    // types.ts's AppUser). Owner-only, and never on the kiosk device itself.
    function kioskPinKeys() {
      return ['kioskPinHash', 'kioskPinSalt', 'kioskPinIterations', 'kioskPinUpdatedAt', 'kioskPinUpdatedBy', 'kioskPinUpdatedByEmail'];
    }
    function pinKeys() {
      return ['pinHash', 'pinSalt', 'pinIterations', 'pinUpdatedAt', 'pinUpdatedBy', 'pinUpdatedByEmail'];
    }

    // The only repair fields a technician may change directly (mirrors
    // TECH_EDITABLE_FIELDS in domain/repairs.ts). completedAt/warrantyUntil are
    // deliberately NOT here — a technician who wrote them directly (e.g. via dev
    // tools, bypassing the app's computed values) could backdate completion to
    // inflate their own Tech Performance turnaround stats, or set an arbitrary
    // warranty end date. They (and completedBy, also never technician-writable)
    // are stamped server-side only, by the techUpdateRepair Cloud Function
    // (functions/src/repairs.ts) using the Admin SDK — never trusted from the
    // client. A technician's own direct writes here can still move `status` to
    // 'picked_up' (the technician-facing terminal state — see TECH_STATUSES in
    // domain/repairs.ts), but completedAt/warrantyUntil will simply be
    // missing/stale until that callable (or a staff write) sets them.
    function techRepairKeys() {
      return ['status', 'techNotes', 'diagnostics', 'workPerformed', 'partsUsed',
              'testingResults', 'testChecks'];
    }
    function techRepairUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(techRepairKeys());
    }

    // ---- Shared shop data ----
    match /user_data/{ws} {
      // The parent doc holds the legacy encrypted blob (read once for migration).
      // Technicians may read the workspace but never write the blob.
      allow read: if activeMemberOf(ws) || request.auth.uid == ws;
      allow write: if isStaffOf(ws) || request.auth.uid == ws;

      // Inventory & accessories: staff (non-technician) create/update; only the
      // owner may delete. Technicians have no inventory write access at all.
      match /inventory/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }
      match /accessories/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }
      // Auto-inventory identity index (domain/autoInventory.ts /
      // commitAutoInventory): one doc per normalized IMEI/serial, written only
      // from inside that transaction alongside the inventory record it points
      // at. Same access as inventory itself — staff write, owner-only delete
      // (matches "never hard-delete inventory records from a ticket action").
      match /inventoryImeiIndex/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Audit logs are append-only: any active member (incl. technicians) may
      // create; no update/delete from clients.
      match /auditLogs/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if activeMemberOf(ws);
        allow update, delete: if false;
      }

      // Repairs: staff may create/update freely; technicians may update only the
      // whitelisted work fields (never create or delete). Owner-only delete.
      match /repairs/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if isStaffOf(ws);
        allow update: if isStaffOf(ws) || (isTechOf(ws) && techRepairUpdateOk());
        allow delete: if isOwnerOf(ws);
      }
      // Repair batches: staff manage; technicians read only. Owner-only delete.
      match /repairBatches/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Time clock: manager/owner (payroll.manage tier — mirrors
      // services/rbac.ts) may write ANY entry, which is what the missed-
      // clock-out correction flow (App.tsx's handleCorrectClockOut, itself
      // audited via 'timeclock.correct_clock_out') needs. Employee AND
      // technician are both self-service ONLY — an employee is not more
      // trusted than a technician here. This closes a real hole: the old
      // isStaffOf() catch-all covered owner/manager/employee with no
      // ownership check at all, so an employee could write ANY coworker's
      // timeEntry directly (bypassing the UI) to backdate/extend their own
      // hours or alter someone else's — backwards from every other
      // trust boundary in this file, where technician is the MORE
      // restricted role.
      //
      // Read stays workspace-wide (activeMemberOf) — a deliberate choice,
      // not an oversight: timeEntries are fetched as one shared collection
      // at the app level for every active role (missed-clock-out flags,
      // the payroll review screen, etc.), and splitting that into a
      // per-user query for employee/technician vs. a full query for
      // manager/owner would be a real architectural change for a field
      // (coworkers' clock-in/out times) that isn't especially sensitive
      // compared to the financial/inventory data already gated more
      // tightly elsewhere in this file.
      // The kiosk punch roster — the ONLY thing the door iPad may read about a
      // person (a display name and a punch-PIN hash; see types.ts's KioskStaff
      // and functions/src/kioskStaffPolicy.ts for why it is not users/{uid}).
      //
      // NO CLIENT WRITE, EVER — not by the kiosk, not by an owner. It is
      // maintained exclusively by the syncKioskStaff Admin-SDK trigger
      // (functions/src/kioskStaff.ts), which is what guarantees a revoked PIN
      // or a deactivated account actually disappears from the door.
      //
      // Read is the kiosk device itself, plus owner/manager so the roster is
      // inspectable from the Users screen. An employee/technician cannot read
      // it: it holds colleagues' PIN hashes, and offline-guessable 6-digit
      // hashes are exactly what should not be handed around.
      match /kioskStaff/{id} {
        allow read: if isKioskOf(ws) || isManagerUp(ws);
        allow write: if false;
      }

      // ---- Kiosk punches, folded into the branches below ----------------
      //
      // A kiosk writes a timeEntry for SOMEBODY ELSE — that is the whole point
      // of a shared door iPad, and it is why the kiosk branch cannot reuse the
      // self-service one (which requires userId == request.auth.uid). The
      // person is authenticated by their 6-digit punch PIN, checked against
      // the kioskStaff mirror on the device; these rules bound what the device
      // can do even if that check were bypassed entirely.
      //
      // A kiosk MAY: create today's clock-in for a user in its own workspace,
      // and update that entry to clock out or start/end a break.
      //
      // A kiosk MAY NOT, and why each matters:
      //   • delete — nothing at the door may destroy an hours record;
      //   • change clockIn — a shift could otherwise be backdated for pay;
      //   • change userId — one person's hours could land on another;
      //   • write corrections/audit fields — those belong to the manager flow;
      //   • touch an entry from a PREVIOUS DAY (withinLastDay on the STORED
      //     clockIn) — nobody fixes their hours at the iPad; a yesterday entry
      //     is a correction, and corrections happen on a real screen with an
      //     audit trail.
      match /timeEntries/{id} {
        // READ is split into get/list so the kiosk's access can be BOUNDED.
        //
        // THE PROBLEM: a kiosk could read the whole collection, so a tablet
        // left unattended by the front door cached months of everyone's
        // hours. The punch screen only needs to know who is on shift right
        // now.
        //
        // In a `list` rule Firestore evaluates the condition against EVERY
        // document the query would return, so requiring withinKioskReadWindow on
        // resource.data.clockIn makes an unbounded query fail outright: it
        // would return an old entry, that entry fails the rule, the whole
        // query is denied. A query carrying the clockIn floor returns only
        // recent entries and is allowed. That is what turns "please send a
        // bounded query" into something the server actually enforces.
        //
        // Owner/manager reads are untouched.
        // The same bound applies to a single-document read, or it would be a
        // way around the list rule one id at a time.
        allow get: if activeMemberOf(ws)
          || (isKioskOf(ws) && withinKioskReadWindow(resource.data.clockIn));
        allow list: if activeMemberOf(ws)
          || (isKioskOf(ws)
              && request.query.limit <= kioskListLimit()
              && withinKioskReadWindow(resource.data.clockIn));
        allow create: if isManagerUp(ws)
          || (isSelfServiceStaffOf(ws)
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.keys().hasOnly(timeEntrySelfKeys())
              && closeToNow(request.resource.data.clockIn)
              // clockOut is optional on create (a fresh clock-in has none
              // yet), but if it IS set it must be skew-checked too — a
              // create with clockOut already hours in the future would
              // otherwise self-record inflated hours in one write, since
              // this path (unlike update below) previously checked no
              // skew on clockOut at all.
              && (!request.resource.data.keys().hasAny(['clockOut']) || request.resource.data.clockOut == null
                  || closeToNow(request.resource.data.clockOut)))
          || (isKioskOf(ws)
              && request.resource.data.keys().hasOnly(kioskEntryKeys())
              && request.resource.data.source == 'kiosk'
              && request.resource.data.userId is string
              && request.resource.data.userId != request.auth.uid
              && closeToNow(request.resource.data.clockIn)
              && (!request.resource.data.keys().hasAny(['clockOut']) || request.resource.data.clockOut == null));
        allow update: if isManagerUp(ws)
          || (isSelfServiceStaffOf(ws)
              && resource.data.userId == request.auth.uid
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(timeEntrySelfUpdateKeys())
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clockOut'])
                  || closeToNow(request.resource.data.clockOut)))
          || (isKioskOf(ws)
              && request.resource.data.userId == resource.data.userId
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(kioskUpdateKeys())
              && kioskBreaksOnlyGrow()
              && withinLastDay(resource.data.clockIn)
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['clockOut'])
                  || closeToNow(request.resource.data.clockOut)));
        // A kiosk may NEVER delete: nothing at the door destroys an hours
        // record. (Not listed here at all — delete is owner-only.)
        allow delete: if isOwnerOf(ws);
      }

      // Staff notes: an internal, owner-only shoutout/notes log about staff.
      // Owner reads/writes; nobody else (managers/employees/technicians) may
      // even read it, matching services/rbac.ts's staffNotes.manage.
      match /staffNotes/{id} {
        allow read, write: if isOwnerOf(ws);
      }

      // Expense ledger (domain/expenses.ts) — general business expenses, any
      // payment method. Expense amounts are cost/profit-sensitive, so the old
      // single `expenses.manage` permission (owner + manager + employee, gated
      // here by isStaffOf) has been split in services/rbac.ts into:
      //   • expenses.add     — owner + manager: create an expense, and
      //                        edit/delete ONLY their own entries.
      //   • expenses.viewAll — owner only: browse the whole ledger and its
      //                        totals, mutate anyone's entry, and configure
      //                        recurring templates/categories.
      // EMPLOYEES AND TECHNICIANS NOW HAVE NO EXPENSE ACCESS AT ALL — not even
      // read. isStaffOf() is deliberately no longer used here.
      //
      // READ, and why it is manager-wide rather than own-entries-only:
      // net profit must keep subtracting EVERY workspace expense, and a
      // manager legitimately holds reports.profit.summary. Firestore evaluates
      // read rules per document even for a collection query, so restricting a
      // manager's read to `enteredBy == uid` would silently truncate the very
      // `expenses` array that feeds domain/reports.ts's profitAndLoss — the
      // manager's P&L would then omit every expense somebody else entered and
      // OVERSTATE net profit. A wrong P&L is a worse outcome than a manager
      // being able to read a peer's expense document, so read stays
      // workspace-wide for the manager tier and the "my submitted expenses
      // only" scoping is applied client-side in components/ReportsView.tsx's
      // ExpensesTab (domain/expenses.ts's visibleExpensesFor). This is an
      // explicit, documented trade-off, not an oversight: the manager READ
      // restriction is UI-level scoping, while the WRITE restriction below is
      // genuinely enforced server-side. Closing the read side properly needs a
      // server-computed expense aggregate the manager may read instead of the
      // raw documents — see the PR discussion.
      //
      // WRITE — airtight here, per document:
      //   create: an owner writes anything; a manager may only create a row
      //           stamped with their OWN uid in enteredBy (so they cannot
      //           file an expense under somebody else's name).
      //   update/delete: an owner any row; a manager only a row whose
      //           EXISTING enteredBy is their own uid, and an update may not
      //           reassign enteredBy away from them.
      match /expenses/{id} {
        allow read: if isManagerUp(ws);
        allow create: if isOwnerOf(ws)
          || (isManagerUp(ws) && request.resource.data.enteredBy == request.auth.uid);
        allow update: if isOwnerOf(ws)
          || (isManagerUp(ws)
              && resource.data.enteredBy == request.auth.uid
              && request.resource.data.enteredBy == request.auth.uid);
        allow delete: if isOwnerOf(ws)
          || (isManagerUp(ws) && resource.data.enteredBy == request.auth.uid);
      }
      // Recurring templates are owner-only CONFIGURATION (which bills recur,
      // at what amount or in variable "enter it each period" mode, and which
      // periods were generated/skipped). A manager may add an expense but
      // never touch the schedule that posts them.
      match /recurringExpenses/{id} {
        allow read, write: if isOwnerOf(ws);
      }

      // Cash drawer: any staff (owner/manager/employee) may log a movement
      // (open, cash in/out, withdrawal), create the day's record, AND count/
      // close it. cash.reconcile is an employee permission now (see
      // services/rbac.ts): an employee closing their own drawer at end of
      // shift is the normal case, and the oversight is the reconciledBy/
      // reconciledByEmail stamp on the record plus the 'cash.reconcile' audit
      // entry — variances stay visible to owner/manager through the existing
      // unreconciled-days flag and cash history, unchanged.
      //
      // Technicians still cannot touch the till at all (isStaffOf excludes
      // them), and only the owner may delete a day's record.
      match /cashReconciliations/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Sales: any staff may complete a new sale (sales.complete) and change a
      // sale's `status` to void/return it — sales.void and sales.return are
      // employee permissions now (services/rbac.ts). A reversal at the counter
      // shouldn't need a manager to walk over; instead every void/return
      // stamps voidedBy/voidedByEmail or returnedBy/returnedByEmail on the
      // transaction itself (App.tsx's handleVoidSale/handleReturnSale) and
      // writes a 'sale.void'/'sale.return' audit entry.
      //
      // Note the void/return WINDOW (settings.operations.voidWindowDays,
      // domain/pos.ts's canVoidSale/canReturnSale) is a business rule enforced
      // client-side; this rule is about who may write, not when.
      match /salesTransactions/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Drop-offs / device buyer settlements: any staff (dropoffs.manage is an
      // employee permission now — see services/rbac.ts). Accepting a drop-off
      // and settling a device buyer both stamp the acting user on the record
      // (acceptedBy/settledBy) and write an audit entry. Technicians have no
      // access; only the owner may delete.
      match /dropOffs/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }
      // `runners` stores DEVICE BUYERS. The concept was renamed to "device
      // buyer" in the UI and code, but the collection path is deliberately
      // left as `runners` for data continuity — renaming it would require
      // migrating every live document. Do NOT rename this path without a
      // matching data migration; it must stay identical to COLLECTIONS in
      // services/firestoreDb.ts and functions/src/backups.ts.
      match /runners/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }
      match /settlements/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Workspace meta doc (settings, notes, tasks, sku counters, backup
      // stamp — see services/firestoreDb.ts's metaRef): any staff may touch
      // it (sku counters advance on every device add, notes/tasks are shared
      // scratch space), EXCEPT the `settings` field, which only the owner may
      // change (settings.manage is owner-only in rbac.ts). saveSettings/
      // saveMeta both write with {merge:true}, so the resulting document
      // always still contains `settings` once the owner has ever saved it —
      // update must gate on the field actually CHANGING (diff), not merely
      // being present in the post-write document, or every later staff note/
      // task save would trip this check forever after the first settings save.
      match /meta/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if isStaffOf(ws) && (isOwnerOf(ws) || !request.resource.data.keys().hasAny(['settings']));
        allow update: if isStaffOf(ws) && (isOwnerOf(ws) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['settings']));
        allow delete: if isOwnerOf(ws);
      }

      // ---- Remaining collections with no restriction beyond isStaffOf ----
      //
      // SECURITY: there used to be a single `match /{document=**}` catch-all
      // here instead of the three blocks below. Firestore rules are OR'd —
      // "any matching rule that allows it, allows it" — and a recursive
      // wildcard matches every document in the workspace, INCLUDING the ones
      // under the dedicated, more restrictive blocks above (cashReconciliations,
      // salesTransactions, meta's settings gate, staffNotes, etc). A comment
      // saying those were "carved out" did nothing: the catch-all's blanket
      // `allow write: if isStaffOf(ws)` and `allow read: if activeMemberOf(ws)`
      // independently permitted every operation those dedicated blocks exist
      // to deny — an employee could reconcile the drawer or void a sale, and
      // any active member (including technicians) could read staffNotes,
      // entirely through this one rule, regardless of what the specific block
      // said. Every stricter block above was dead code for those paths.
      //
      // The fix is enumeration, not a wildcard: only the collections listed
      // explicitly below get access, and only the access spelled out here.
      // A future collection gets NO access — not even read — until a rule is
      // added for it. That is the deliberate posture now, not an oversight;
      // see services/firestoreDb.ts's COLLECTIONS for the full inventory of
      // what the client actually writes, and cross-check any addition there
      // against a rule here before shipping it.
      match /customers/{id} {
        allow read: if activeMemberOf(ws);
        allow write: if isStaffOf(ws);
      }
      // General activity feed (services/firestoreDb.ts's logActivityDoc) —
      // distinct from auditLogs above, which is the append-only compliance
      // trail. This one is a lighter-weight UI feed staff may write/prune.
      match /activityLog/{id} {
        allow read: if activeMemberOf(ws);
        allow write: if isStaffOf(ws);
      }
      // Pay-period sign-off records (services/firestoreDb.ts's
      // savePayPeriodPaid/deletePayPeriodPaid) — this is the "mark paid"
      // acknowledgment, gated owner-only (App.tsx's handleMarkPaid), same as
      // this rule now enforces server-side. Previously `isStaffOf(ws)` let
      // ANY employee mark (or unmark) a period paid directly, bypassing the
      // UI entirely — the same class of rules/UI mismatch closed for
      // timeEntries above.
      match /payPeriods/{id} {
        allow read: if activeMemberOf(ws);
        allow write: if isOwnerOf(ws);
      }
      // Pay-period APPROVAL records — a distinct, earlier step than
      // payPeriods above: manager/owner (payroll.manage tier) sign off that
      // one employee's numbers for a period are correct, before the owner
      // marks it paid. See App.tsx's handleApprovePayPeriod.
      match /payPeriodApprovals/{id} {
        allow read: if activeMemberOf(ws);
        allow write: if isManagerUp(ws);
      }
      // Staff bonuses (domain/bonuses.ts) — one-off payments on top of hours.
      //
      // WRITE: owner only. A bonus is money out of the business decided by the
      // owner; a manager may approve a pay period but does not award bonuses.
      // Matching App.tsx, which gates the button on the owner role.
      //
      // READ: the payroll tier (owner + manager), plus the person the bonus
      // belongs to. A bonus is somebody's pay — an employee must never be able
      // to read a colleague's, which a blanket `activeMemberOf(ws)` (the rule
      // payPeriods uses) would have allowed. The per-document userId check is
      // what makes the UI's visibility rule (domain/bonuses.ts's canSeeBonus)
      // actually enforced rather than merely respected by the client.
      //
      // Written EXPLICITLY rather than left to a catch-all, so the read
      // restriction is stated where it is enforced.
      match /staffBonuses/{id} {
        allow read: if isManagerUp(ws)
          || (activeMemberOf(ws) && resource.data.userId == request.auth.uid);
        allow write: if isOwnerOf(ws);
      }
    }

    // ---- Users registry ----
    match /users/{uid} {
      // A user reads their own profile; owners and managers read profiles in
      // their workspace (managers need this to list/manage technicians).
      allow read: if signedIn() && (request.auth.uid == uid
        || (hasProfile() && (myRole() == 'owner' || myRole() == 'manager') && resource.data.workspaceId == myWorkspace()));

      // First-login self-provisioning: create only your own doc, and either become
      // the owner of your own workspace, or claim a matching invite.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.id == uid
        && (
          (request.resource.data.role == 'owner' && request.resource.data.workspaceId == uid)
          || (
            exists(/databases/$(database)/documents/workspaceInvites/$(request.auth.token.email.lower()))
            && request.resource.data.workspaceId == get(/databases/$(database)/documents/workspaceInvites/$(request.auth.token.email.lower())).data.workspaceId
            && request.resource.data.role == get(/databases/$(database)/documents/workspaceInvites/$(request.auth.token.email.lower())).data.role
          )
        );

      // Self may only update lastLogin and notifSeenTs (the two fields a
      // client legitimately self-writes — see hooks/useWorkspaceData.ts's
      // login stamp and App.tsx's handleMarkNotificationsSeen); everything
      // else, including allowProfit and the PIN fields, requires an owner/
      // manager acting on someone else via the branches below. An owner may
      // change role/disabled/allowProfit/hourlyRate for members of their
      // workspace; a manager may only toggle `disabled` on a technician
      // account (no role or workspace changes). hourlyRate is owner-set pay,
      // so a user may never change their own (nor could they under hasOnly
      // below, since it's not in the self-editable set).
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'notifSeenTs']))
        // The owner's broad branch: role/disabled/allowProfit/hourlyRate for
        // anyone in their workspace.
        //
        // The one carve-out is a KIOSK DEVICE's credential fields. Without it
        // this branch swallows the narrower PIN branches below — it grants
        // every field, so OR-ing a stricter rule after it changes nothing —
        // and an owner could put an app-unlock PIN, or a punch PIN, on the
        // shared door iPad. A device must hold neither: the unlock PIN opens a
        // session, and the punch PIN would make the iPad clock itself in.
        || (hasProfile() && myRole() == 'owner' && resource.data.workspaceId == myWorkspace()
            && (resource.data.role != 'kiosk'
                || !request.resource.data.diff(resource.data).affectedKeys().hasAny(pinKeys().concat(kioskPinKeys()))))
        || (hasProfile() && myRole() == 'manager'
            && resource.data.workspaceId == myWorkspace()
            && resource.data.role == 'technician'
            && request.resource.data.role == 'technician'
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']))
        // PIN assignment: owner/manager may set the PIN fields ONLY on a user
        // strictly below their own role rank (never a peer or above), and only
        // those fields — no role/workspace/disabled/pay change riding along.
        || (hasProfile() && (myRole() == 'owner' || myRole() == 'manager')
            && resource.data.workspaceId == myWorkspace()
            && resource.data.role != 'kiosk'
            && roleRank(resource.data.role) < roleRank(myRole())
            && request.resource.data.role == resource.data.role
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(pinKeys()))
        // KIOSK PUNCH PIN — a different credential from the app-unlock PIN
        // above (see types.ts's AppUser). Owner-only, because a punch PIN
        // decides whose hours get recorded. Never settable on the kiosk
        // DEVICE account itself: a device has no shifts to punch.
        //
        // The owner writes only these six fields here; the syncKioskStaff
        // trigger then mirrors them into the kioskStaff roster the door iPad
        // reads. That mirror is never client-writable.
        || (hasProfile() && myRole() == 'owner'
            && resource.data.workspaceId == myWorkspace()
            && resource.data.role != 'kiosk'
            && request.resource.data.role == resource.data.role
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(kioskPinKeys()))
      );

      allow delete: if hasProfile() && myRole() == 'owner' && resource.data.workspaceId == myWorkspace();
    }

    // ---- Invites ----
    match /workspaceInvites/{email} {
      // The invited user may read their own invite (to claim it); owners and
      // managers read them (managers to list technician invites).
      allow read: if signedIn() && (
        request.auth.token.email.lower() == email
        || (hasProfile() && (myRole() == 'owner' || myRole() == 'manager'))
      );
      // Owners create/update any invite; managers only technician invites.
      allow create, update: if hasProfile()
        && request.resource.data.workspaceId == myWorkspace()
        && (myRole() == 'owner'
            || (myRole() == 'manager' && request.resource.data.role == 'technician'));
      // Deletable by the invitee (on claim), the owner, or a manager for a
      // technician invite.
      allow delete: if signedIn() && (
        request.auth.token.email.lower() == email
        || (hasProfile() && myRole() == 'owner')
        || (hasProfile() && myRole() == 'manager' && resource.data.role == 'technician' && resource.data.workspaceId == myWorkspace())
      );
    }
  }
}
