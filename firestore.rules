rules_version = '2';

// IMPORTANT: These rules encode the app's role model. Test them in the Firebase
// console Rules Playground before relying on them in production — they cannot be
// exercised in CI.
//
// Data model:
//   users/{uid}                      -> { email, role, workspaceId, disabled, ... }
//   workspaceInvites/{email}         -> { email, workspaceId, role }
//   user_data/{workspaceId}/...      -> all shared shop collections
// workspaceId == the owning account's uid; staff share the owner's workspace.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myUserPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(myUserPath()); }
    function me() { return get(myUserPath()).data; }
    function myWorkspace() { return me().workspaceId; }
    function myRole() { return me().role; }
    // `disabled` is optional on the user doc; use get(...,false) so a missing
    // field is treated as "not disabled" instead of erroring (an errored rule
    // denies, which previously blocked every workspace read for normal users).
    function activeMemberOf(ws) { return hasProfile() && me().get('disabled', false) != true && myWorkspace() == ws; }
    function isOwnerOf(ws) { return activeMemberOf(ws) && myRole() == 'owner'; }
    function isTechOf(ws) { return activeMemberOf(ws) && myRole() == 'technician'; }
    // A non-technician active member (owner/manager/employee) — the roles that
    // may write general shop data.
    function isStaffOf(ws) { return activeMemberOf(ws) && myRole() != 'technician'; }
    // Owner or manager — the roles services/rbac.ts grants cash.reconcile,
    // sales.void, sales.return and dropoffs.manage to (employees get cash.log
    // but NOT reconcile/void/return/dropoffs; the generic isStaffOf() catch-all
    // used to let an employee bypass that server-side, which the rules below
    // for cashReconciliations/salesTransactions/dropOffs/runners/settlements
    // close).
    function isManagerUp(ws) { return activeMemberOf(ws) && (myRole() == 'owner' || myRole() == 'manager'); }

    // Role rank for PIN assignment (domain/pin.ts mirrors this exactly): an
    // owner/manager may set a PIN only for someone STRICTLY below their own
    // rank — never a peer or above, so a manager can never PIN another manager
    // or the owner, and nobody can PIN themselves via this path.
    function roleRank(r) {
      return r == 'owner' ? 3 : r == 'manager' ? 2 : r == 'employee' ? 1 : 0;
    }
    function pinKeys() {
      return ['pinHash', 'pinSalt', 'pinIterations', 'pinUpdatedAt', 'pinUpdatedBy', 'pinUpdatedByEmail'];
    }

    // The only repair fields a technician may change (mirrors TECH_EDITABLE_FIELDS
    // in domain/repairs.ts, plus the completedAt/warrantyUntil the app stamps when
    // a device is picked up).
    function techRepairKeys() {
      return ['status', 'techNotes', 'diagnostics', 'workPerformed', 'partsUsed',
              'testingResults', 'testChecks', 'completedAt', 'warrantyUntil'];
    }
    function techRepairUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(techRepairKeys());
    }

    // ---- Shared shop data ----
    match /user_data/{ws} {
      // The parent doc holds the legacy encrypted blob (read once for migration).
      // Technicians may read the workspace but never write the blob.
      allow read: if activeMemberOf(ws) || request.auth.uid == ws;
      allow write: if isStaffOf(ws) || request.auth.uid == ws;

      // Inventory & accessories: staff (non-technician) create/update; only the
      // owner may delete. Technicians have no inventory write access at all.
      match /inventory/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }
      match /accessories/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }
      // Auto-inventory identity index (domain/autoInventory.ts /
      // commitAutoInventory): one doc per normalized IMEI/serial, written only
      // from inside that transaction alongside the inventory record it points
      // at. Same access as inventory itself — staff write, owner-only delete
      // (matches "never hard-delete inventory records from a ticket action").
      match /inventoryImeiIndex/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Audit logs are append-only: any active member (incl. technicians) may
      // create; no update/delete from clients.
      match /auditLogs/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if activeMemberOf(ws);
        allow update, delete: if false;
      }

      // Repairs: staff may create/update freely; technicians may update only the
      // whitelisted work fields (never create or delete). Owner-only delete.
      match /repairs/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if isStaffOf(ws);
        allow update: if isStaffOf(ws) || (isTechOf(ws) && techRepairUpdateOk());
        allow delete: if isOwnerOf(ws);
      }
      // Repair batches: staff manage; technicians read only. Owner-only delete.
      match /repairBatches/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Time clock: staff manage any shift; a technician may create/update only
      // their OWN shifts (userId == their uid) so they can clock in without the
      // broader write access technicians are otherwise denied. Owner-only delete.
      match /timeEntries/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isStaffOf(ws)
          || (isTechOf(ws) && request.resource.data.userId == request.auth.uid);
        allow delete: if isOwnerOf(ws);
      }

      // Staff notes: an internal, owner-only shoutout/notes log about staff.
      // Owner reads/writes; nobody else (managers/employees/technicians) may
      // even read it, matching services/rbac.ts's staffNotes.manage.
      match /staffNotes/{id} {
        allow read, write: if isOwnerOf(ws);
      }

      // Cash drawer: any staff (incl. employees, per cash.log) may log a
      // movement (open, cash in/out, withdrawal) or create the day's record,
      // but only owner/manager may touch the reconcile/close fields
      // (cash.reconcile) — an employee closing out their own drawer count
      // unsupervised is exactly what cash.reconcile is meant to gate.
      //
      // Every write here is a full-document overwrite, not a Firestore-level
      // merge (App.tsx's commitDrawerRecord merges client-side, then setDoc's
      // the whole record) — and re-opening a previously-closed day explicitly
      // CLEARS reconciledAt/reconciledBy/reconciledByEmail/countedCash back to
      // absent (domain/reports.ts's openDrawerPatch), which any staff must
      // still be able to do. So the gate isn't "did a reconcile key change"
      // (removing one on reopen is a legitimate cash.log action) — it's
      // "is a reconcile key being SET to a real value" (present in the new
      // doc AND different from before).
      function reconcileKeys() { return ['reconciledAt', 'reconciledBy', 'reconciledByEmail', 'countedCash', 'note']; }
      function settingReconcileFields() {
        return request.resource.data.diff(resource.data).affectedKeys().hasAny(reconcileKeys())
          && request.resource.data.keys().hasAny(reconcileKeys());
      }
      match /cashReconciliations/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if isStaffOf(ws) && (isManagerUp(ws) || !request.resource.data.keys().hasAny(reconcileKeys()));
        allow update: if isStaffOf(ws) && (isManagerUp(ws) || !settingReconcileFields());
        allow delete: if isOwnerOf(ws);
      }

      // Sales: any staff may complete a new sale (sales.complete), but only
      // owner/manager may change a sale's `status` (sales.void / sales.return)
      // — an employee reversing their own sale unsupervised is exactly what
      // those permissions are meant to gate. Other field-only edits (e.g. the
      // customer-merge relink of customerId/Phone/Email) stay open to any
      // staff as long as status itself isn't part of the write.
      match /salesTransactions/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if isStaffOf(ws);
        allow update: if isStaffOf(ws) &&
          (isManagerUp(ws) || request.resource.data.get('status', null) == resource.data.get('status', null));
        allow delete: if isOwnerOf(ws);
      }

      // Drop-offs / runner settlements: owner/manager only (dropoffs.manage) —
      // an employee has no drop-off write access at all, matching rbac.ts.
      match /dropOffs/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isManagerUp(ws);
        allow delete: if isOwnerOf(ws);
      }
      match /runners/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isManagerUp(ws);
        allow delete: if isOwnerOf(ws);
      }
      match /settlements/{id} {
        allow read: if activeMemberOf(ws);
        allow create, update: if isManagerUp(ws);
        allow delete: if isOwnerOf(ws);
      }

      // Workspace meta doc (settings, notes, tasks, sku counters, backup
      // stamp — see services/firestoreDb.ts's metaRef): any staff may touch
      // it (sku counters advance on every device add, notes/tasks are shared
      // scratch space), EXCEPT the `settings` field, which only the owner may
      // change (settings.manage is owner-only in rbac.ts). saveSettings/
      // saveMeta both write with {merge:true}, so the resulting document
      // always still contains `settings` once the owner has ever saved it —
      // update must gate on the field actually CHANGING (diff), not merely
      // being present in the post-write document, or every later staff note/
      // task save would trip this check forever after the first settings save.
      match /meta/{id} {
        allow read: if activeMemberOf(ws);
        allow create: if isStaffOf(ws) && (isOwnerOf(ws) || !request.resource.data.keys().hasAny(['settings']));
        allow update: if isStaffOf(ws) && (isOwnerOf(ws) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['settings']));
        allow delete: if isOwnerOf(ws);
      }

      // Everything else in the workspace (customers, timeEntries already
      // handled above, payPeriods…): active staff read/write; technicians
      // read-only. The sensitive collections above are carved out from this
      // catch-all specifically because it grants isStaffOf() — which includes
      // employees — write access with no further restriction.
      match /{document=**} {
        allow read: if activeMemberOf(ws);
        allow write: if isStaffOf(ws);
      }
    }

    // ---- Users registry ----
    match /users/{uid} {
      // A user reads their own profile; owners and managers read profiles in
      // their workspace (managers need this to list/manage technicians).
      allow read: if signedIn() && (request.auth.uid == uid
        || (hasProfile() && (myRole() == 'owner' || myRole() == 'manager') && resource.data.workspaceId == myWorkspace()));

      // First-login self-provisioning: create only your own doc, and either become
      // the owner of your own workspace, or claim a matching invite.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.id == uid
        && (
          (request.resource.data.role == 'owner' && request.resource.data.workspaceId == uid)
          || (
            exists(/databases/$(database)/documents/workspaceInvites/$(request.auth.token.email.lower()))
            && request.resource.data.workspaceId == get(/databases/$(database)/documents/workspaceInvites/$(request.auth.token.email.lower())).data.workspaceId
            && request.resource.data.role == get(/databases/$(database)/documents/workspaceInvites/$(request.auth.token.email.lower())).data.role
          )
        );

      // Self may only update lastLogin and notifSeenTs (the two fields a
      // client legitimately self-writes — see hooks/useWorkspaceData.ts's
      // login stamp and App.tsx's handleMarkNotificationsSeen); everything
      // else, including allowProfit and the PIN fields, requires an owner/
      // manager acting on someone else via the branches below. An owner may
      // change role/disabled/allowProfit/hourlyRate for members of their
      // workspace; a manager may only toggle `disabled` on a technician
      // account (no role or workspace changes). hourlyRate is owner-set pay,
      // so a user may never change their own (nor could they under hasOnly
      // below, since it's not in the self-editable set).
      allow update: if signedIn() && (
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin', 'notifSeenTs']))
        || (hasProfile() && myRole() == 'owner' && resource.data.workspaceId == myWorkspace())
        || (hasProfile() && myRole() == 'manager'
            && resource.data.workspaceId == myWorkspace()
            && resource.data.role == 'technician'
            && request.resource.data.role == 'technician'
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']))
        // PIN assignment: owner/manager may set the PIN fields ONLY on a user
        // strictly below their own role rank (never a peer or above), and only
        // those fields — no role/workspace/disabled/pay change riding along.
        || (hasProfile() && (myRole() == 'owner' || myRole() == 'manager')
            && resource.data.workspaceId == myWorkspace()
            && roleRank(resource.data.role) < roleRank(myRole())
            && request.resource.data.role == resource.data.role
            && request.resource.data.workspaceId == resource.data.workspaceId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(pinKeys()))
      );

      allow delete: if hasProfile() && myRole() == 'owner' && resource.data.workspaceId == myWorkspace();
    }

    // ---- Invites ----
    match /workspaceInvites/{email} {
      // The invited user may read their own invite (to claim it); owners and
      // managers read them (managers to list technician invites).
      allow read: if signedIn() && (
        request.auth.token.email.lower() == email
        || (hasProfile() && (myRole() == 'owner' || myRole() == 'manager'))
      );
      // Owners create/update any invite; managers only technician invites.
      allow create, update: if hasProfile()
        && request.resource.data.workspaceId == myWorkspace()
        && (myRole() == 'owner'
            || (myRole() == 'manager' && request.resource.data.role == 'technician'));
      // Deletable by the invitee (on claim), the owner, or a manager for a
      // technician invite.
      allow delete: if signedIn() && (
        request.auth.token.email.lower() == email
        || (hasProfile() && myRole() == 'owner')
        || (hasProfile() && myRole() == 'manager' && resource.data.role == 'technician' && resource.data.workspaceId == myWorkspace())
      );
    }
  }
}
