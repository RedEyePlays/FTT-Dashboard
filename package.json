    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.5.2",
    "happy-dom": "^20.11.6",
    "postcss": "^8.5.15",
